<h1>{{title}}</h1>
{{#if conocido}}
    <p>Bienvenido {{nombre}} <a href="/salir">Cerrar sesión</a></p>
    {{/if}}

    {{#unless conocido}}
    <p>No te conozco</p>
    <form action="/ingresar" method="POST">
        <input type="text" name="nombre"><button>Ingresar</button>
    </form>
    {{/unless}}